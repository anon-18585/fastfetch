{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "source": "./themes/noctalia.jsonc",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/$USER/.config/fastfetch/logo/warp.PNG",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 5,
      "left": 4
    },
    "color": {
      "1": "#63a8e4",
      "2": "#5c5ed6"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢  PC"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 "
    },
    {
      "type": "gpu",
      "key": "│ ├󰍹 "
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 "
    },
    {
      "type": "disk",
      "key": "└ └󰋊 "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "kernel",
      "key": "│ ├󰌽 "
    },
    {
      "type": "bios",
      "key": "│ ├󰖡 "
    },
    {
      "type": "packages",
      "key": "│ ├󰏗 "
    },
    {
      "type": "shell",
      "key": "└ └󰞷 "
    },
    "break",
    {
      "type": "de",
      "key": "󰧨  DE"
    },
    {
      "type": "lm",
      "key": "│ ├󰍁 "
    },
    {
      "type": "wm",
      "key": "│ ├󱂬 "
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉦 "
    },
    {
      "type": "terminal",
      "key": "└ └󰆍 "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Uptime / Age / DT────────────────────┐"
    },
    {
      "type": "command",
      "key": "  ›  OS Age  ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  ›  Uptime  "
    },
    {
      "type": "datetime",
      "key": "  ›  DateTime  "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ],
  "display": {
    "color": {
      "keys": "#67a8e4",
      "title": "#5c5ed6"
    },
    "percent": {
      "color": {
        "green": "#9761d1",
        "yellow": "#93c1ec",
        "red": "#fd4663"
      }
    }
  }
}
